{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-registry/schema/by-length.schema.json",
  "title": "Generated lookup shard (<source-repo>/by-length/<codeLength>.json): every entry of that length, as in entries/ (role, implementationSlots and packages included), each with the tags whose builds produced it. Never hand-edited.",
  "type": "object",
  "required": ["schemaVersion", "repo", "codeLength", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "repo": { "$ref": "common.schema.json#/$defs/repo" },
    "codeLength": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/entry",
        "properties": { "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        "required": ["tags"],
        "unevaluatedProperties": false
      }
    }
  }
}
