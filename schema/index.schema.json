{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract-registry/schema/index.schema.json",
  "title": "Generated summary (registry/index.json): the code lengths that have a by-length file, of every source, and per source its repo and getters. A source's getters are those of its own entries and of every entry its tag and branch files reference; the walker calls them on unknown code in a walk of that source. Never hand-edited.",
  "type": "object",
  "required": ["schemaVersion", "codeLengths", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/viewSchemaVersion" },
    "codeLengths": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "sources": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/sourceId" },
      "additionalProperties": {
        "type": "object",
        "required": ["repo", "getters"],
        "additionalProperties": false,
        "properties": {
          "repo": { "$ref": "common.schema.json#/$defs/repo" },
          "getters": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/getter" } }
        }
      }
    }
  }
}
